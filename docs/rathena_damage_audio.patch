+static constexpr bool ENABLE_OPENMIDGARD_DAMAGE_AUDIO = PACKETVER == 20080910;
+
+static void clif_write_damage_audio(unsigned char* buf, block_list* src, block_list* dst,
+	uint16 skill_id, uint16 skill_lv, const Damage* hitAudio)
+{
+	block_list* attacker = src;
+	if (src->type == BL_SKILL) {
+		TBL_SKILL* unit = (TBL_SKILL*)src;
+		if (unit->group) {
+			if (block_list* caster = map_id2bl(unit->group->src_id)) attacker = caster;
+		}
+	}
+	map_session_data* sd = BL_CAST(BL_PC, attacker);
+	const status_data* status = status_get_status_data(attacker);
+	const uint16 level = skill_lv > 0 && skill_lv < 1000 ? skill_lv : 1;
+	const int kind = hitAudio ? hitAudio->flag : skill_id ? skill_get_type(skill_id) : BF_WEAPON;
+	const bool magic = (kind & BF_MAGIC) != 0;
+	const bool ranged = hitAudio ? (hitAudio->flag & BF_LONG) != 0
+		: skill_id ? skill_get_range(skill_id, level) > 3 : status->rhw.range > 3;
+	int element = skill_id ? skill_get_ele(skill_id, level, dst) : ELE_WEAPON;
+	if (element == ELE_ENDOWED) element = status_get_attack_sc_element(attacker, status_get_sc(attacker));
+	const int right = hitAudio && hitAudio->hitAudioElementKnown ? hitAudio->hitAudioElement[0]
+		: element == ELE_WEAPON ? status->rhw.ele : element;
+	const int left = hitAudio && hitAudio->hitAudioElementKnown ? hitAudio->hitAudioElement[1]
+		: element == ELE_WEAPON ? status->lhw.ele : element;
+	const bool arrows = !magic && sd && (sd->weapontype1 == W_BOW || sd->weapontype1 == W_MUSICAL);
+	WBUFB(buf,33) = (magic ? 2 : 1) | (ranged ? 4 : 0) | (sd ? 8 : 0);
+	WBUFB(buf,34) = arrows ? (hitAudio && hitAudio->hitAudioElementKnown ? right : sd->bonus.arrow_ele) : right;
+	WBUFB(buf,35) = sd ? sd->weapontype1 : W_FIST;
+	WBUFB(buf,36) = left;
+	WBUFB(buf,37) = sd ? (sd->weapontype2 ? sd->weapontype2 : sd->weapontype1) : W_FIST;
+}
